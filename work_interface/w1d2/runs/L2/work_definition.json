  },
  "purpose": "Reconcile supplier statements with internal ledger to identify matching invoices, missing records on either side, and amount differences.",
  "sources": {
    "supplier-statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
      "observed_fields": ["Date", "Supplier Name", "InvoiceNumber", "Amount", "Currency", "Status"],
      "basis": "observed"
    },
    "internal-ledger": {
      "role_label": "Internal Ledger",
      "fixture": "ledger-book.txt",
      "observed_fields": ["Date", "ReferenceNumber", "SupplierName", "InvoiceNumber", "Amount", "Status", "Notes"],
      "basis": "observed"
    }
  },
  "body": {
    "left": "supplier-statement",
    "right": "internal-ledger",
    "match_on": {
      "left_field": "InvoiceNumber",
      "right_field": "InvoiceNumber",
      "basis": "human_confirmed",
      "confirmation": "Q_match_key_invoice_number"
    },
    "compare": [
      {
        "field": "Amount",
        "comparison": "within",
        "tolerance": "0.01",
        "basis": "human_confirmed",
        "confirmation": "Q_compare_amount_within_tolerance"
      }
    ],
    "classify": {
      "both_same": "matched_invoice",
      "both_different": "amount_mismatch",
      "only_left": "statement_only_record",
      "only_right": "ledger_only_record"
    },
    "output_order": "left_then_right",
    "on_duplicate_key": "refuse_run",
    "on_non_numeric": "refuse_key"
  },
  "output": {
    "reports_fields": ["InvoiceNumber", "Amount"],
    "context_fields": ["Date", "Supplier Name", "Status"]
  },
  "human_confirmations": [
    {
      "id": "Q_match_key_invoice_number",
      "question": "Which field identifies the same record / invoice in both files?",
      "answer": "InvoiceNumber",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_compare_amount_within_tolerance",
      "question": "Should Amount be compared, and if so, how and with what tolerance? Is Currency part of the reconciliation rule?",
      "answer": "Yes, compare Amount numerically, within 0.01. No, Currency is not compared and is not part of the rule.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_source_of_truth",
      "question": "Which file is the source of truth for matching?",
      "answer": "Neither — both are peer sources. Report what is missing from either side and differences in the compared field.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_report_fields",
      "question": "Which fields should appear in the report row? Which fields are context for the report?",
      "answer": "The match key (InvoiceNumber) and the compared field (Amount). Date, Supplier Name, and Status.",
      "basis": "human_confirmed"
    }
  ],
  "open_questions": [],
  "requested_destination": "review_only",
  "requested_delivery": {
    "format": "json_discrepancy_report"
  },
