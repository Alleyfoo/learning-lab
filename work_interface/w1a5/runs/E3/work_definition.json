  "purpose": "Reconcile supplier statement with internal ledger using InvoiceNumber as the unique identifier, comparing Amount within currency tolerance.",
  "sources": {
    "statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
