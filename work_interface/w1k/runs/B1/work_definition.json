{
  "work_definition_version": 0,
  "task_family": "reconciliation",
  "model_id": "AcmeCorpReconciler",
  "provenance": {
    "producer": "goose",
    "skill": "define-lab-process",
    "produced_at": "2026-08-21"
  },
  "purpose": "reconcile supplier invoices between external statement and internal ledger, identifying missing records and amount discrepancies",
  "sources": {
    "statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
      "observed_fields": ["Date", "Supplier Name", "InvoiceNumber", "Amount", "Currency", "Status"],
      "basis": "observed"
    },
    "ledger": {
      "role_label": "Internal Ledger Book",
      "fixture": "ledger-book.txt",
      "observed_fields": ["Date", "ReferenceNumber", "SupplierName", "InvoiceNumber", "Amount", "Status", "Notes"],
      "basis": "observed"
    }
  },
  "body": {
    "left": "statement",
    "right": "ledger",
    "match_on": {
      "left_field": "InvoiceNumber",
      "right_field": "InvoiceNumber",
      "basis": "human_confirmed",
      "confirmation": "Q_match_key"
    },
    "compare": [
      {
        "field": "Amount",
        "comparison": "within",
        "tolerance": "0.01",
        "basis": "human_confirmed",
        "confirmation": "Q_compare_amount_field"
      }
    ],
    "classify": {
      "both_same": "matched",
      "both_different": "amount_discrepancy",
      "only_left": "statement_only_invoice",
      "only_right": "ledger_only_record"
    },
    "output_order": "left_then_right",
    "on_duplicate_key": "refuse_run",
    "on_non_numeric": "refuse_key"
  },
  "output": {
    "reports_fields": ["InvoiceNumber", "Amount"],
    "context_fields": ["Date", "SupplierName", "Status"],
    "provenance": {
      "reports_fields": {
        "basis": "human_confirmed",
        "confirmation": "Q_report_columns"
      },
      "context_fields": {
        "basis": "human_confirmed",
        "confirmation": "Q_context_data"
      }
    }
  },
  "human_confirmations": [
    {
      "id": "Q_match_key",
      "question": "What field identifies the same record/invoice in both the Supplier Statement and the Internal Ledger Book?",
      "answer": "InvoiceNumber",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_compare_amount_field",
      "question": "Should Amount be compared, and if so, how and with what tolerance?",
      "answer": "Yes, compare Amount numerically, within 0.01.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_currency_not_compared",
      "question": "Is Currency part of the reconciliation rule?",
      "answer": "No. All sample amounts are GBP; Currency is not compared and is not part of the rule.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_source_truth",
      "question": "Which file is the source of truth for matching?",
      "answer": "Neither — both are peer sources. Report what is missing from either side and differences in the compared field.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_report_columns",
      "question": "Which fields should appear in the report row?",
      "answer": "The match key (InvoiceNumber) and the compared field (Amount).",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_context_data",
      "question": "Which fields are context for the report?",
      "answer": "Date, Supplier Name, and Status.",
      "basis": "human_confirmed"
    }
  ],
  "open_questions": [],
  "requested_destination": "review_only",
  "requested_delivery": { "format": "json_discrepancy_report" },
  "requested_authority": null
}