    "skill": "define-lab-process",
    "produced_at": "2026-08-21"
  },
  "purpose": "Reconcile supplier statements with internal ledger to identify discrepancies in invoice amounts between peer sources",
  "sources": {
    "statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
      "observed_fields": ["Date", "Supplier Name", "InvoiceNumber", "Amount", "Currency", "Status"],
      "basis": "observed"
    },
    "ledger": {
      "role_label": "Internal Ledger Book",
      "fixture": "ledger-book.txt",
      "observed_fields": ["Date", "ReferenceNumber", "SupplierName", "InvoiceNumber", "Amount", "Status", "Notes"],
      "basis": "observed"
    }
  },
  "body": {
    "left": "statement",
    "right": "ledger",
    "match_on": {
      "left_field": "InvoiceNumber",
      "right_field": "InvoiceNumber",
      "basis": "human_confirmed",
      "confirmation": "Q_match_key"
    },
    "compare": [
      {
        "field": "Amount",
        "comparison": "within",
        "tolerance": "0.01",
        "basis": "human_confirmed",
        "confirmation": "Q_compare_field"
      }
    ],
    "classify": {
      "both_same": "MATCHED",
      "both_different": "DISCREPANCY",
      "only_left": "MISSING_IN_LEDGER",
      "only_right": "MISSING_IN_STATEMENT"
    },
    "output_order": "sorted_by_key",
    "on_duplicate_key": "refuse_run",
    "on_non_numeric": "refuse_key"
  },
  "output": {
    "reports_fields": ["InvoiceNumber", "Amount"],
    "context_fields": ["Date", "Supplier Name", "SupplierName", "Status"]
  },
  "human_confirmations": [
    {
      "id": "Q_match_key",
      "question": "Which field identifies the same record / invoice in both files?",
      "answer": "InvoiceNumber",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_compare_field",
      "question": "Should Amount be compared, and if so, how and with what tolerance? Is Currency part of the reconciliation rule?",
      "answer": "Yes, compare Amount numerically, within 0.01. No, all sample amounts are GBP; Currency is not compared and is not part of the rule.",
      "basis": "human_confirmed"
    }
  ],
  "open_questions": [],
  "requested_destination": "review_only",
  "requested_delivery": { "format": "json_discrepancy_report" },
  "requested_authority": null
