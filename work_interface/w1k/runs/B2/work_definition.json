{
  "work_definition_version": 0,
  "task_family": "reconciliation",
  "model_id": "w1-k-b2-supplier-ledger",
  "provenance": {
    "producer": "goose B2-synth-reconcile",
    "skill": "define-lab-process",
    "produced_at": "2026-08-21"
  },
  "purpose": "Reconcile supplier statement and internal ledger invoices by matching on InvoiceNumber and comparing Amount within tolerance 0.01",
  "sources": {
    "statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
      "observed_fields": ["Date", "Supplier Name", "InvoiceNumber", "Amount", "Currency", "Status"],
      "basis": "observed"
    },
    "ledger": {
      "role_label": "Internal Ledger Book",
      "fixture": "ledger-book.txt",
      "observed_fields": ["Date", "ReferenceNumber", "SupplierName", "InvoiceNumber", "Amount", "Status", "Notes"],
      "basis": "observed"
    }
  },
  "body": {
    "left": "statement",
    "right": "ledger",
    "match_on": {
      "left_field": "InvoiceNumber",
      "right_field": "InvoiceNumber",
      "basis": "human_confirmed",
      "confirmation": "Q_match_key"
    },
    "compare": [
      {
        "field": "Amount",
        "comparison": "within",
        "tolerance": "0.01",
        "basis": "human_confirmed",
        "confirmation": "Q_comparison_amount"
      }
    ],
    "classify": {
      "both_same": "matched",
      "both_different": "discrepancy",
      "only_left": "statement_only",
      "only_right": "ledger_only"
    },
    "output_order": "left_then_right",
    "on_duplicate_key": "refuse_run",
    "on_non_numeric": "refuse_key"
  },
  "output": {
    "reports_fields": ["InvoiceNumber", "Amount"],
    "context_fields": ["Date", "Supplier Name", "ReferenceNumber", "Currency", "Status", "Notes"],
    "provenance": {
      "reports_fields": {
        "basis": "human_confirmed",
        "confirmation": "Q_report_fields"
      },
      "context_fields": {
        "basis": "human_confirmed",
        "confirmation": "Q_context_fields"
      }
    }
  },
  "human_confirmations": [
    {
      "id": "Q_match_key",
      "question": "Which field identifies the same record / invoice in both files?",
      "answer": "InvoiceNumber",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_comparison_amount",
      "question": "Should Amount be compared, and if so, how and with what tolerance?",
      "answer": "Yes, compare Amount numerically, within 0.01.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_status_not_compared",
      "question": "Is Currency part of the reconciliation rule? Which fields should be compared?",
      "answer": "No. All sample amounts are GBP; Currency is not compared and is not part of the rule. Status is not compared; only the match key InvoiceNumber and field Amount are used for comparison.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_source_of_truth",
      "question": "Which file is the source of truth for matching?",
      "answer": "Neither — both are peer sources. Report what is missing from either side and differences in the compared field.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_report_fields",
      "question": "Which fields should appear in the report row?",
      "answer": "The match key (InvoiceNumber) and the compared field (Amount).",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_context_fields",
      "question": "Which fields are context for the report?",
      "answer": "Date, Supplier Name, and Status.",
      "basis": "human_confirmed"
    }
  ],
  "open_questions": [],
  "requested_destination": "review_only",
  "requested_delivery": {
    "format": "json_discrepancy_report"
  },
