          "rawInput": {
            "command": "$artifacts_dir = \"C:\\Users\\pertt\\learning-lab\\work_interface\\w1f\\runs\\N3\"\n$json_content = @\"\n{\n  \"work_definition_version\": 0,\n  \"task_family\": \"reconciliation\",\n  \"model_id\": \"invoice-amt-recon-v0\",\n  \"provenance\": {\n    \"producer\": \"goose-N3\",\n    \"skill\": \"define-lab-process\",\n    \"produced_at\": \"2026-08-20\"\n  },\n  \"purpose\": \"reconcile supplier statements with internal ledgers on invoice number comparing amounts within tolerance\",\n  \"sources\": {\n    \"statement\": {\n      \"role_label\": \"Supplier Statement\",\n      \"fixture\": \"supplier-statement.txt\",\n      \"observed_fields\": [\"Date\", \"Supplier Name\", \"InvoiceNumber\", \"Amount\", \"Currency\", \"Status\"],\n      \"basis\": \"observed\"\n    },\n    \"ledger\": {\n      \"role_label\": \"Internal Ledger Book\",\n      \"fixture\": \"ledger-book.txt\",\n      \"observed_fields\": [\"Date\", \"ReferenceNumber\", \"SupplierName\", \"InvoiceNumber\", \"Amount\", \"Status\", \"Notes\"],\n      \"basis\": \"observed\"\n    }\n  },\n  \"body\": {\n    \"left\": \"statement\",\n    \"right\": \"ledger\",\n    \"match_on\": {\n      \"left_field\": \"InvoiceNumber\",\n      \"right_field\": \"InvoiceNumber\",\n      \"basis\": \"human_confirmed\",\n      \"confirmation\": \"Q_match_key\"\n    },\n    \"compare\": [\n      {\n        \"field\": \"Amount\",\n        \"comparison\": \"within\",\n        \"tolerance\": \"0.01\",\n        \"basis\": \"human_confirmed\",\n        \"confirmation\": \"Q_compare_amount\"\n      }\n    ],\n    \"classify\": {\n      \"both_same\": \"matched\",\n      \"both_different\": \"amount_mismatch\",\n      \"only_left\": \"statement_only\",\n      \"only_right\": \"ledger_only\"\n    },\n    \"output_order\": \"sorted_by_key\",\n    \"on_duplicate_key\": \"refuse_run\",\n    \"on_non_numeric\": \"refuse_key\"\n  },\n  \"output\": {\n    \"reports_fields\": [\"InvoiceNumber\", \"Amount\"],\n    \"context_fields\": [\"Date\", \"Supplier Name\", \"SupplierName\", \"Status\"]\n  },\n  \"human_confirmations\": [\n    {\n      \"id\": \"Q_match_key\",\n      \"question\": \"Which field identifies the same record / invoice in both files?\",\n      \"answer\": \"InvoiceNumber\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_compare_amount\",\n      \"question\": \"Should Amount be compared, and if so, how and with what tolerance?\",\n      \"answer\": \"Yes, compare Amount numerically, within 0.01.\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_currency_exclusion\",\n      \"question\": \"Is Currency part of the reconciliation rule?\",\n      \"answer\": \"No. All sample amounts are GBP; Currency is not compared and is not part of the rule.\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_authority_relation\",\n      \"question\": \"Which file is the source of truth for matching?\",\n      \"answer\": \"Neither — both are peer sources. Report what is missing from either side and differences in the compared field.\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_reports_fields\",\n      \"question\": \"Which fields should appear in the report row?\",\n      \"answer\": \"The match key (InvoiceNumber) and the compared field (Amount).\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_context_fields\",\n      \"question\": \"Which fields are context for the report?\",\n      \"answer\": \"Date, Supplier Name, and Status.\",\n      \"basis\": \"human_confirmed\"\n    },\n    {\n      \"id\": \"Q_output_order\",\n      \"question\": \"Which output_order should be used for report rows?\",\n      \"answer\": \"sorted_by_key so matching invoices appear together in the report.\",\n      \"basis\": \"human_confirmed\"\n    }\n  ],\n  \"open_questions\": [],\n  \"requested_destination\": \"review_only\",\n  \"requested_delivery\": { \"format\": \"json_discrepancy_report\" },\n  \"requested_authority\": null\n}\n\"@\n\n$json_content | Out-File -FilePath \"$artifacts_dir\\work_definition.json\" -Encoding UTF8\n\nWrite-Host \"work_definition.json written to $artifacts_dir\\work_definition.json\""
