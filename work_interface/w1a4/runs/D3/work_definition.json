{
  "work_definition_version": 0,
  "task_family": "reconciliation",
  "model_id": "supplier-ledger-reconcile",
  "provenance": {
    "producer": "gpt-4-o",
    "skill": "define-lab-process",
    "produced_at": "2026-08-20"
  },
  "purpose": "Reconcile supplier statement and internal ledger records to identify missing transactions from either side and amount discrepancies using InvoiceNumber as the match key.",
  "sources": {
    "statement": {
      "role_label": "Supplier Statement",
      "fixture": "supplier-statement.txt",
      "observed_fields": ["Date", "Supplier Name", "InvoiceNumber", "Amount", "Currency", "Status"],
      "basis": "observed"
    },
    "ledger": {
      "role_label": "Internal Ledger Book",
      "fixture": "ledger-book.txt",
      "observed_fields": ["Date", "ReferenceNumber", "SupplierName", "InvoiceNumber", "Amount", "Status", "Notes"],
      "basis": "observed"
    }
  },
  "body": {
    "left": "statement",
    "right": "ledger",
    "match_on": {
      "left_field": "InvoiceNumber",
      "right_field": "InvoiceNumber",
      "basis": "human_confirmed",
      "confirmation": "Q_match_key"
    },
    "compare": [
      {
        "field": "Amount",
        "comparison": "within",
        "tolerance": "0.01",
        "basis": "human_confirmed",
        "confirmation": "Q_compare_field"
      }
    ],
    "classify": {
      "both_same": "matched_amounts",
      "both_different": "discrepant_amounts",
      "only_left": "in_statement_only",
      "only_right": "in_ledger_only"
    },
    "output_order": "sorted_by_key",
    "on_duplicate_key": "refuse_run",
    "on_non_numeric": "refuse_run"
  },
  "output": {
    "reports_fields": ["InvoiceNumber", "Amount"],
    "context_fields": ["Status"]
  },
  "human_confirmations": [
    {
      "id": "Q_match_key",
      "question": "Which field identifies the same record in both files?",
      "answer": "InvoiceNumber",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_compare_field",
      "question": "Compare Amount field with what comparison and tolerance? Is any other field part of the reconciliation rule?",
      "answer": "Yes, compare Amount numerically, within 0.01.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_source_of_truth",
      "question": "Which file is the source of truth if there's a disagreement (or are they peers)?",
      "answer": "Neither — both are peer sources. Report what is missing from either side and differences in the compared field.",
      "basis": "human_confirmed"
    },
    {
      "id": "Q_report_format",
      "question": "Which fields should appear in the report row, and which are context?",
      "answer": "The match key (InvoiceNumber) and the compared field (Amount).",
      "basis": "human_confirmed"
    }
  ],
  "open_questions": [],
  "requested_destination": "review_only",
  "requested_delivery": {
    "format": "json_discrepancy_report"
  },
